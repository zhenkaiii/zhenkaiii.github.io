      "boundElements": [],
      "updated": 1766545942347,
      "link": null,
      "locked": false,
      "text": "Dispatch gate (default rate):\n  IF ∃ GPU with free execution slot\n     AND predicted wait ≤ deadline\n  THEN dispatch\n\nSelection:\n  choose GPU with minimal predicted finish time\nBatching:\nBatching decisions are made before kernel launch,\nby the host-side execution engine.\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "VP6yl__3gMUYPHaFRhX09",
      "originalText": "Dispatch gate (default rate):\n  IF ∃ GPU with free execution slot\n     AND predicted wait ≤ deadline\n  THEN dispatch\n\nSelection:\n  choose GPU with minimal predicted finish time\nBatching:\nBatching decisions are made before kernel launch, by the host-side execution engine.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
